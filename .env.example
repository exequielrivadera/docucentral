# PostgreSQL administrado (por ejemplo, Neon). No uses una SQLite local en Vercel.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require

# Credenciales SMTP de Brevo: completar como variables de entorno en Vercel.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=docucentrallr@gmail.com
BREVO_SENDER_NAME=DocuCentral
